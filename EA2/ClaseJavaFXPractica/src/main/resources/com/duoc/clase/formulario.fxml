<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.duoc.clase.FormularioController"
      alignment="CENTER"
      spacing="15"
      style="-fx-padding: 30;">
    <Label text="Registro de estudiante"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <TextField
            fx:id="txtNombre"
            promptText="Ingrese Nombre"/>
    <TextField
            fx:id="txtCorreo"
            promptText="ingrese Correo"/>
    <ComboBox
            fx:id="cmbCarrera"
            promptText="Selecciona Carrera"
            prefWidth="390"/>
    <Button
            text="Registrar"
            onAction="#registrar"/>
    <Label
            fx:id="lblResultado"
            text="Complete el Formulario"/>

</VBox>